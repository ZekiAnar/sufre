<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/sufre_widget_bg">
    <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/w_line1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/w_line2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textColor="#F3D9DE" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_water" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_plus" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="6dp" android:paddingBottom="6dp"
            android:background="@drawable/sufre_widget_btn" android:textColor="#A3263B" android:textStyle="bold" android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
